#BlueJ class context
comment0.target=Ball
comment0.text=\r\n\ A\ Ball\ is\ a\ thing\ that\ bounces\ of\ walls\ and\ paddles\ (or\ at\ least\ i\ should).\r\n
comment1.params=
comment1.target=Ball()
comment1.text=\r\n\ Contructs\ the\ ball\ and\ sets\ it\ in\ motion\!\r\n
comment10.params=
comment10.target=void\ checkBounceOffCeiling()
comment10.text=\r\n\ Check\ to\ see\ if\ the\ ball\ should\ bounce\ off\ the\ ceiling.\r\n\ If\ touching\ the\ ceiling\ the\ ball\ is\ bouncing\ off.\r\n
comment11.params=
comment11.target=void\ checkRestart()
comment11.text=\r\n\ Check\ to\ see\ if\ the\ ball\ should\ be\ restarted.\r\n\ If\ touching\ the\ floor\ the\ ball\ is\ restarted\ in\ initial\ position\ and\ speed.\r\n\ Also\ checks\ for\ life\ deduction\ and\ win/loss\ game.\r\n
comment12.params=
comment12.target=void\ revertHorizontally()
comment12.text=\r\n\ Bounces\ the\ ball\ back\ from\ a\ vertical\ surface.\r\n\ Reverts\ horizontal\ direction\ (left/right\ wall\ hits).\r\n\ Calculates\ the\ return\ angle\ and\ plays\ a\ bounce\ sound.\r\n
comment13.params=countScore
comment13.target=void\ revertVertically(boolean)
comment13.text=\r\n\ Bounces\ the\ ball\ back\ from\ a\ horizontal\ surface.\r\n\ Checks\ for\ the\ specific\ conditions\ of\ losing,\ winning\ or\ alternate\ ending,\ and\ resets\ ball\ in\ center\ for\ next\ round.\r\n
comment14.params=
comment14.target=void\ hitSound()
comment15.params=
comment15.target=void\ failSound()
comment15.text=\r\n\ Plays\ sound\ effects\ upon\ losing\ a\ point/life\ or\ the\ game\r\n
comment16.params=
comment16.target=void\ scoreSound()
comment16.text=\r\n\ Plays\ sound\ effect\ upon\ scoring\ a\ point\ against\ the\ opponent\r\n
comment17.params=
comment17.target=void\ winSound()
comment17.text=\r\n\ Plays\ sound\ effect\ upon\ winning\ the\ game\ and\ have\ scored\ the\ required\ amount\ to\ win\r\n
comment18.params=
comment18.target=Scoreboard\ getScoreboard()
comment19.params=
comment19.target=void\ init()
comment19.text=\r\n\ Initialize\ the\ ball\ settings.\r\n
comment2.params=manager
comment2.target=void\ setGameManager(GameManager)
comment3.params=
comment3.target=void\ createImage()
comment3.text=\r\n\ Creates\ and\ sets\ an\ image\ of\ a\ black\ ball\ to\ this\ actor.\r\n
comment4.params=
comment4.target=void\ act()
comment4.text=\r\n\ Act\ -\ do\ whatever\ the\ Ball\ wants\ to\ do.\ This\ method\ is\ called\ whenever\r\n\ the\ 'Act'\ or\ 'Run'\ button\ gets\ pressed\ in\ the\ environment.\r\n
comment5.params=
comment5.target=boolean\ isTouchingSides()
comment5.text=\r\n\ Returns\ true\ if\ the\ ball\ is\ touching\ one\ of\ the\ side\ walls.\r\n
comment6.params=
comment6.target=boolean\ isTouchingCeiling()
comment6.text=\r\n\ Returns\ true\ if\ the\ ball\ is\ touching\ the\ ceiling.\r\n
comment7.params=
comment7.target=boolean\ isTouchingFloor()
comment7.text=\r\n\ Returns\ true\ if\ the\ ball\ is\ touching\ the\ floor.\r\n
comment8.params=
comment8.target=void\ checkBounceOffPaddle()
comment8.text=\r\n\ Checks\ for\ collision\ with\ any\ type\ of\ Paddle\ classes.\r\n\ Then\ reverts\ in\ a\ vertical\ direction\ after\ being\ in\ contact,\ and\ handles\ bounce/pass\ through\ logic.\r\n
comment9.params=
comment9.target=void\ checkBounceOffWalls()
comment9.text=\r\n\ Check\ to\ see\ if\ the\ ball\ should\ bounce\ off\ one\ of\ the\ walls.\r\n\ If\ touching\ one\ of\ the\ walls,\ the\ ball\ is\ bouncing\ off.\r\n
